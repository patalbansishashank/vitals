{
  "name": "vitals-companion",
  "version": "0.8.6",
  "private": true,
  "description": "Vitals Server: sync relay, per-person store (home role), device pairing, AI proxy and MCP on one port.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.10.0"
  },
  "bin": {
    "vitals-server": "./bin/vitals-server.mjs",
    "vitals-companion": "./bin/vitals-companion.mjs"
  },
  "scripts": {
    "start": "node ./bin/vitals-companion.mjs",
    "build": "vite build -c vite.person.config.ts && node scripts/pack.mjs",
    "build:person": "vite build -c vite.person.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@evolu/common": "8.14.0",
    "@evolu/nodejs": "4.1.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "12.11.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1"
  }
}
