{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.companion.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "bin", "../../src/sync"],
  // the person program runs the app's own graph (`@/` alias, React types): tsconfig.app.json checks these
  "exclude": ["src/home/identicalBatch.test.ts", "src/home/freshReplica.test.ts", "src/home/personProgram.ts", "src/home/personProgram.test.ts", "src/home/personWorkerEntry.ts", "src/home/chunkCopies.test.ts", "src/home/syncedScores.test.ts", "src/home/notOnServer.test.ts", "src/home/agentWrites.test.ts"]
}
