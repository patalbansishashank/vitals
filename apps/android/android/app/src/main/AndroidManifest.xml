<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions (SUITE_SPEC §15.7): the network, the camera for the QR scanner, and app updates from the home
         server (vitals-research/ota/CONTRACT.md). -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates: no APK download over 30 MB on a metered network unless the owner taps. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updates: the owner taps "Update ready" and the system's own confirmation asks once more (OtaInstall, an install
         session); never a silent install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- QR scanner in the web layer (getUserMedia). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Gauge's workout control on this phone (energy SPEC §A.4 item 10): start, pause, resume and stop a recording
         through Gauge's permission-protected broadcast API. Dangerous protection level: requested at runtime for the
         Gauge that is installed. The result receiver is created in code (VitalsGaugePlugin), never declared here. -->
    <uses-permission android:name="com.pulseloop.permission.CONTROL_WORKOUT" />
    <uses-permission android:name="com.pulseloop.debug.permission.CONTROL_WORKOUT" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Package visibility (Android 11+): Vitals looks for Gauge only, the release and the debug build. -->
    <queries>
        <package android:name="com.pulseloop" />
        <package android:name="com.pulseloop.debug" />
    </queries>

    <!-- No backup of any kind: the WebView storage holds the health database, the sync words and the server pairing.
         allowBackup off; fullBackupContent off for Android 8–11; data_extraction_rules excludes everything from cloud
         backup and device transfer on Android 12+. -->
    <application
        android:name=".VitalsApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Link: a server pairing link (https://vitals.creative.desi/settings…) opens the app's own Settings
                 page; the site serves assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="vitals.creative.desi" />
                <data android:pathPrefix="/settings" />
            </intent-filter>

        </activity>

        <!-- Home-screen widgets (0.6.6, r071): the Today glance, Heart rate (the class that was Ring), the Log / Record keys,
             the one-tap Log, and one provider per card (Energy, Sleep, Steps, Weight). App-widget providers only: not
             exported (the system's widget host reaches them), home screen only, drawn from the snapshot the app publishes
             (VitalsWidgetsPlugin); no service, no network. A provider's class name never changes: renaming or removing
             one deletes the widgets placed from it. -->
        <receiver
            android:name=".widgets.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".widgets.RingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_ring_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ring_info" />
        </receiver>

        <receiver
            android:name=".widgets.ActionsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_actions_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_actions_info" />
        </receiver>

        <receiver
            android:name=".widgets.LogWidgetProvider"
            android:exported="false"
            android:label="@string/widget_log_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_log_info" />
        </receiver>

        <receiver
            android:name=".widgets.EnergyWidgetProvider"
            android:exported="false"
            android:label="@string/widget_energy_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_energy_info" />
        </receiver>

        <receiver
            android:name=".widgets.SleepWidgetProvider"
            android:exported="false"
            android:label="@string/widget_sleep_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sleep_info" />
        </receiver>

        <receiver
            android:name=".widgets.StepsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_steps_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info" />
        </receiver>

        <receiver
            android:name=".widgets.WeightWidgetProvider"
            android:exported="false"
            android:label="@string/widget_weight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weight_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
