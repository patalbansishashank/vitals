<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen card, wide (a 4x2 and up): the figure and its facts on the left, the picture on the right. Same slots as
     widget_card_ring.xml; VitalsWidgets.kt fills them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vw_card_gold_wide"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal">
            <ImageView android:id="@+id/vw_icon" android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/vw_icon_energy" />
            <TextView android:id="@+id/vw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/geist_semibold" android:includeFontPadding="false" android:letterSpacing="-0.005" android:maxLines="1" android:textColor="@color/vw_ink" android:textSize="14sp" />
            <TextView android:id="@+id/vw_asof" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_3" android:textSize="9sp" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/vw_split"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/vw_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="46"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/vw_hero" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/geist_light" android:fontFeatureSettings="pnum" android:includeFontPadding="false" android:letterSpacing="-0.035" android:maxLines="1" android:textColor="@color/vw_ink" android:textSize="40sp" />
                        <TextView android:id="@+id/vw_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/geist_regular" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/vw_ink_2" android:textSize="12sp" android:visibility="gone" />
                    </LinearLayout>
                    <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_word" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/geist_regular" android:includeFontPadding="false" android:maxLines="3" android:textColor="@color/vw_ink" android:textSize="16sp" android:visibility="gone" />
                    <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/geist_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="3" android:textAllCaps="true" android:textColor="@color/vw_ink_2" android:textSize="10sp" android:visibility="gone" />
                </LinearLayout>
                <ImageView android:id="@+id/vw_viz" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="54" android:importantForAccessibility="no" android:scaleType="fitCenter" android:visibility="gone" />
            </LinearLayout>
            <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:includeFontPadding="false" android:fontFamily="@font/geist_regular" android:gravity="center" android:maxLines="4" android:textColor="@color/vw_ink_2" android:textSize="13sp" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/vw_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:minHeight="16dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/vw_state" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="@font/geist_regular" android:includeFontPadding="false" android:maxLines="1" android:textColor="@color/vw_ink_2" android:textSize="12sp" />
            <TextView android:id="@+id/vw_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.06" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_2" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
