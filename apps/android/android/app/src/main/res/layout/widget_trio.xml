<?xml version="1.0" encoding="utf-8"?>
<!-- The Today glance (a 4x2): three rings, Steps, Energy and Sleep, each in its own hue with its figure inside and its label
     under it, each its own tap; a gold card (the plan leads). In quiet mode two rings and a word under each. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vw_card_gold_wide"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/vw_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/vw_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/geist_semibold" android:includeFontPadding="false" android:letterSpacing="-0.005" android:maxLines="1" android:textColor="@color/vw_ink" android:textSize="14sp" />
            <TextView android:id="@+id/vw_day" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_2" android:textSize="10sp" />
            <TextView android:id="@+id/vw_asof" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_3" android:textSize="9sp" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/vw_cells"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/vw_cell1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView android:id="@+id/vw_ring1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                    <TextView android:id="@+id/vw_hero1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/geist_light" android:fontFeatureSettings="pnum" android:includeFontPadding="false" android:letterSpacing="-0.035" android:maxLines="1" android:textColor="@color/vw_ink" android:textSize="22sp" />
                </FrameLayout>
                <TextView android:id="@+id/vw_label1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="14dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:gravity="center_vertical" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_2" android:textSize="10sp" />
                <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_word1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/geist_regular" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:textColor="@color/vw_ink" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/vw_cell2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView android:id="@+id/vw_ring2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                    <TextView android:id="@+id/vw_hero2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/geist_light" android:fontFeatureSettings="pnum" android:includeFontPadding="false" android:letterSpacing="-0.035" android:maxLines="1" android:textColor="@color/vw_ink" android:textSize="22sp" />
                </FrameLayout>
                <TextView android:id="@+id/vw_label2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="14dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:gravity="center_vertical" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_2" android:textSize="10sp" />
                <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_word2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/geist_regular" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:textColor="@color/vw_ink" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/vw_cell3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <ImageView android:id="@+id/vw_ring3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitCenter" />
                    <TextView android:id="@+id/vw_hero3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="@font/geist_light" android:fontFeatureSettings="pnum" android:includeFontPadding="false" android:letterSpacing="-0.035" android:maxLines="1" android:textColor="@color/vw_ink" android:textSize="22sp" />
                </FrameLayout>
                <TextView android:id="@+id/vw_label3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="14dp" android:ellipsize="end" android:fontFamily="@font/geist_mono_medium" android:gravity="center_vertical" android:includeFontPadding="false" android:letterSpacing="0.08" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/vw_ink_2" android:textSize="10sp" />
                <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_word3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="@font/geist_regular" android:gravity="center" android:includeFontPadding="false" android:maxLines="2" android:textColor="@color/vw_ink" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
            </LinearLayout>
            <TextView android:breakStrategy="simple" android:hyphenationFrequency="none" android:id="@+id/vw_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:includeFontPadding="false" android:fontFamily="@font/geist_regular" android:gravity="center" android:maxLines="3" android:textColor="@color/vw_ink_2" android:textSize="13sp" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
