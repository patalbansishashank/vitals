<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen only (never the lock screen: widgetCategory has no keyguard). The snapshot is redrawn every 30 minutes
     from what the app last published, so the snapshot's age and the clock stay true; nothing is fetched. One provider
     per card: the picker is the library, and pinning needs no configuration screen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_trio"
    android:previewImage="@drawable/vw_preview_today"
    android:description="@string/widget_today_description"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000" />
