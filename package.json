{
  "name": "vitals",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:planner": "vitest run --config vitest.bench.config.ts",
    "test:release": "vitest run --maxWorkers=50% --exclude \"**/*bench*.test.ts\" --exclude \"**/safety.props.test.ts\" --exclude \"**/validation/invariants.test.ts\" --exclude \"**/evidence/__tests__/page.test.tsx\" && vitest run --no-file-parallelism bench safety.props.test validation/invariants.test evidence/__tests__/page.test",
    "release": "pnpm typecheck && pnpm lint && pnpm test:release && pnpm audit:planner && pnpm version",
    "audit:planner": "vitest run --config src/engine/planner/audit/vitest.audit.config.ts part. && vitest run --config src/engine/planner/audit/vitest.audit.config.ts report.audit",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "spike:sync": "vitest run --config packages/companion/spike/vitest.config.ts",
    "brand": "node scripts/brand/generate.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.5.2",
    "@evolu/common": "8.14.0",
    "@evolu/web": "3.4.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@scure/bip39": "2.4.0",
    "@vitals/rings": "workspace:*",
    "comlink": "^4.4.2",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "qr-scanner": "1.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uplot": "^1.6.32",
    "uqr": "0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@evolu/nodejs": "4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.4.1"
  }
}
