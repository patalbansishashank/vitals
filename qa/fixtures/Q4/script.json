   "id": "J1-training-days",
   "user": "training days to Tue/Thu",
   "steps": [
    {
     "tools": [
      {
       "name": "plan_shift",
       "args": {
        "from": "{{next:Mon}}",
        "days": 1,
        "mode": "swap",
        "withDate": "{{next:Tue}}"
       }
      }
     ]
    },
    {
     "tools": [
      {
       "name": "plan_shift",
       "args": {
        "from": "{{next:Wed}}",
        "days": 1,
        "mode": "swap",
        "withDate": "{{next:Thu}}"
       }
      }
     ]
    },
    {
     "tools": [
      {
       "name": "plan_edit_day",
       "args": {
        "date": "{{next:Fri}}",
