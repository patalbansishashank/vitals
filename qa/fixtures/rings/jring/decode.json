  "clockVectors": [
    {
      "name": "offset is captured at construction",
      "test": "JringClockTest.kt",
      "asserted": true,
      "steps": [
        {
          "do": "construct",
          "zone": "America/Los_Angeles",
          "atS": 1768478400,
          "expectOffsetS": -28800
        }
      ]
    },
    {
      "name": "capture re-latches the offset",
      "test": "JringClockTest.kt",
      "asserted": true,
      "steps": [
        {
          "do": "construct",
          "zone": "UTC",
          "atS": 1768478400,
          "expectOffsetS": 0
        },
        {
          "do": "capture",
          "zone": "America/Los_Angeles",
          "atS": 1768478400,
          "expectOffsetS": -28800
        }
      ]
    },
    {
      "name": "date subtracts the latched offset from a ring-stamped epoch",
      "test": "JringClockTest.kt",
      "asserted": true,
      "steps": [
        {
          "do": "construct",
          "zone": "America/Los_Angeles",
          "atS": 1768478400,
          "expectOffsetS": -28800
        },
        {
          "do": "date",
          "ringEpochS": 1768449600,
          "expectEpochS": 1768478400
        }
      ]
    },
    {
      "name": "offset follows daylight saving time at the instant used",
      "test": "derived from JringClock (TimeZone.getOffset at the instant)",
      "asserted": false,
      "steps": [
        {
          "do": "construct",
          "zone": "America/Los_Angeles",
          "atS": 1784116800,
          "expectOffsetS": -25200
        }
      ]
    },
    {
      "name": "the offset is not refreshed on its own: it stays at the last capture until the next capture",
      "test": "derived from JringClock",
      "asserted": false,
      "steps": [
        {
          "do": "construct",
          "zone": "America/Los_Angeles",
          "atS": 1768478400,
          "expectOffsetS": -28800
        },
        {
          "do": "date",
          "ringEpochS": 1784088000,
          "expectEpochS": 1784116800,
          "note": "still subtracts the winter offset after the zone is in daylight time, until capture() runs again (JringSyncEngine.enqueueTimeSync)"
        }
      ]
    }
  ]
