{
  "family": "jring",
  "source": "RingDecoderTest.kt (decoder assertions) and JringClockTest.kt; vectors marked asserted:false come from reading RingDecoder.kt and RingDecodedEvent.kt. Synthetic only.",
  "contextKeys": {
    "clockOffsetS": "null = RingDecoder(clock = null); a number = the offset latched by JringClock (seconds east of UTC)"
  },
  "matchModes": {
    "exact": "output list equals the expected list, in order, comparing the listed fields (and \"also\" fields)",
    "first": "only the first output event is compared",
    "contains": "every expected event appears somewhere in the output; output has at least minCount events"
  },
  "vectors": [
    {
      "name": "decode activity update from valid packet",
      "context": {
        "clockOffsetS": null
      },
      "bytes": "03 00 00 00 00 e8 03 00 00 c4 09 00 00 96 00 00 00 00 00 00",
      "events": [
        {
          "kotlin": "ActivityUpdate",
          "steps": 1000,
          "distanceMeters": 2500,
          "calories": 150,
          "also": {
            "timestampS": 0,
            "activeMinutes": null,
            "replaceActiveMinutes": false
          }
        }
      ],
      "match": "exact",
      "test": "RingDecoderTest.kt: decode activity update from valid packet",
      "asserted": true,
      "note": "bytes 1..4 timestamp (zero here), 5..8 steps, 9..12 distance m, 13..16 calories, all u32le. Test asserts the three counters and that exactly one event comes back."
    },
