        {
          "expectWrite": "16 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "16 f0 00 00 00 00 0a 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "16 aa 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "16 a0 58 76 53 65 00 00 3e 40 3f 41 3d 3f 46 48 47 47 48 46",
