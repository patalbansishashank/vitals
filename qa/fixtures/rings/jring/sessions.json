{
  "family": "jring",
  "source": "Scripted from JringSyncEngine, RingBLEClient, RingSyncCoordinator and the decoder layouts. No ring capture was available: every notification is synthetic, so replies the ring may not really send are marked in the notes. Expected RingEvents follow docs/jring.md \"Mapping to RingEvent\"; entries with proposed:true are design suggestions, not Kotlin behaviour.",
  "gatt": {
    "service": "000056ff-0000-1000-8000-00805f9b34fb",
    "write": "000033f3-0000-1000-8000-00805f9b34fb",
    "notify": "000033f4-0000-1000-8000-00805f9b34fb",
    "battery": "00002a19-0000-1000-8000-00805f9b34fb"
  },
  "stepKinds": {
    "do": "harness action: handshake, sync, liveHeartRateStart, liveHeartRateStop, spot:hr, spot:spo2, spot:combined, resyncTime, forget, or a RingCommand object",
    "expectSubscribe": "the session subscribes to this notify characteristic (16-bit alias)",
    "expectRead": "the session reads this characteristic (16-bit alias); readReply is the value returned",
    "expectWrite": "next write on 33f3. Hex of fewer than 20 bytes is a prefix match; 20 bytes is exact. nowMs and tzOffsetS come from the session context",
    "notify": "packets the peripheral sends on 33f4 right after that write, in order",
    "notifyUnsolicited": "packets the peripheral sends with no preceding write",
    "advanceMs": "the virtual clock moves forward (timers fire)",
    "setContext": "replaces nowMs and tzOffsetS from here on",
    "expectEvents": "RingEvents produced by the step (listed fields must match; tolerance is an absolute numeric tolerance; proposed:true marks a design suggestion)"
  },
  "sessions": [
    {
      "name": "connect handshake (first pass of a connection)",
      "note": "Order is JringSyncEngine.runStartup after the notify subscription. Kotlin fire-and-forgets every write; a port may wait for a reply. Replies marked synthetic are built from the decoder layouts, not captured. The 0x48 app-identifier write is only sent when an app id is configured, so it is absent here. The ring volunteers 0x03 on connect (RingEncoder comment); unverified timing.",
      "context": {
        "nowMs": 1700000000000,
        "tzOffsetS": -28800,
        "firstPassOnConnection": true,
        "profile": null
      },
      "steps": [
        {
          "expectSubscribe": "33f4"
        },
        {
          "expectRead": "2a19",
          "readReply": "55",
          "expectEvents": [
            {
              "type": "status",
              "key": "battery",
              "value": 85
            }
          ]
        },
        {
          "do": "handshake"
        },
        {
          "expectWrite": "0c 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "0c 8a 00 11 22 33 44 55 66 3a 00 2a 00 00 00 00 00 00 00 00"
          ],
          "expectEvents": [
            {
              "type": "status",
              "key": "firmware",
              "value": "003A002AV138"
            },
            {
              "type": "status",
              "key": "serial",
              "value": "11:22:33:44:55:66",
              "proposed": true
            }
          ]
        },
        {
          "expectWrite": "01 80 80 53 65 f8 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "01 80 80 53 65 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
          ],
          "note": "time sync for nowMs 1700000000000, tzOffsetS -28800; the echo is synthetic (unverified that the ring answers)",
          "expectEvents": [
            {
              "type": "status",
              "key": "ack",
              "value": "time_sync",
              "proposed": true
            }
          ]
        },
        {
          "expectWrite": "21 65 6e 2d 55 53 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        },
        {
          "expectWrite": "02 99 b8 5a 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
          ],
          "note": "default profile; the ack is synthetic",
          "expectEvents": [
            {
              "type": "status",
              "key": "ack",
              "value": "cmd_0x02",
              "proposed": true
            }
          ]
        },
        {
          "expectWrite": "19 00 00 17 3b 01 1e 01 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        },
        {
          "expectWrite": "20 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "20 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00"
          ],
          "note": "capabilities reply is synthetic (bit 65 set)",
          "expectEvents": [
            {
              "type": "status",
              "key": "capabilities",
              "value": "00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00"
            }
          ]
        },
        {
          "notifyUnsolicited": [
            "03 80 80 53 65 d2 04 00 00 84 03 00 00 2d 00 00 00 00 00 00"
          ],
          "expectEvents": [
            {
              "type": "dailyTotal",
              "localDay": 1699920000000,
              "steps": 1234,
              "distanceM": 900,
              "kcal": 45,
              "proposed": true
            }
          ],
          "note": "0x03 cumulative day totals; localDay is the ring-local date (2023-11-14) at UTC midnight in ms; the calories unit is unverified"
        },
        {
          "expectWrite": "10 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        },
        {
          "expectWrite": "16 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        }
      ],
      "expectHandshake": {
        "firmware": "003A002AV138",
        "battery": 85,
        "serial": "11:22:33:44:55:66",
        "clockOffsetS": 0,
        "note": "serial and clockOffsetS are proposals (see docs/jring.md)"
      }
    },
    {
      "name": "ring-driven bind handshake (0x4B)",
      "note": "The ring sends INIT, the app answers APP_START, the ring ACKs, the app answers SUCCESS. When the ring starts it is unverified; JringSyncEngine.handle reacts to whichever arrives.",
      "context": {
        "nowMs": 1700000000000,
        "tzOffsetS": 0
      },
      "steps": [
        {
          "notifyUnsolicited": [
            "4b 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
          ]
        },
        {
          "expectWrite": "4b 01 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "4b 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
          ]
        },
        {
          "expectWrite": "4b 04 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        }
      ]
    },
    {
      "name": "history read, first pass (3 days): activity, sleep and heart-rate history",
      "note": "tzOffsetS is +05:30 on purpose: every ring time (0x10, 0x11, 0x16) is local wall-clock, so the raw times in the packets are the expected UTC times plus 19800 s and a decoder that leaves any stream raw fails here. Packet contents are synthetic. Sleep arrives as consecutive 15-minute packets; activity as 15 one-minute buckets per packet; 0x16 ends with ff.",
      "context": {
        "nowMs": 1700000000000,
        "tzOffsetS": 19800,
        "firstPassOnConnection": true,
        "firmware": "003A002AV138"
      },
