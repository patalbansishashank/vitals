    {
      "name": "live heart rate: start, samples, stop",
      "note": "Samples are 0x14 pushes (about one a second). A zero timestamp means the ring could not read: no event. Stop writes 0x15 and then re-arms the background logging with 0x19 (JringSyncEngine.stopHeartRate). tzOffsetS is 0 because the Kotlin uses the raw 0x14 timestamp.",
      "context": {
        "nowMs": 1700000100000,
        "tzOffsetS": 0
      },
      "steps": [
        {
          "do": "liveHeartRateStart"
        },
        {
          "expectWrite": "14 b4 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "14 65 f1 53 65 48 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "14 66 f1 53 65 4a 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "14 00 00 00 00 48 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "14 68 f1 53 65 4b 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
          ],
          "expectEvents": [
            {
              "type": "sample",
              "stream": "hr",
              "t": 1700000101000,
              "value": 72,
              "unit": "bpm",
              "origin": "live"
            },
            {
              "type": "sample",
              "stream": "hr",
              "t": 1700000102000,
              "value": 74,
              "unit": "bpm",
              "origin": "live"
            },
            {
              "type": "sample",
              "stream": "hr",
              "t": 1700000104000,
              "value": 75,
              "unit": "bpm",
              "origin": "live",
              "note": "the all-zero-timestamp packet between is dropped"
            }
          ]
        },
        {
          "do": "liveHeartRateStop"
        },
        {
          "expectWrite": "15 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        },
        {
          "expectWrite": "19 00 00 17 3b 01 1e 01 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": []
        }
      ]
    },
    {
      "name": "spot measurement: combined (SpO2, blood pressure, fatigue, stress, glucose estimate)",
      "note": "Start 0x23 mode 2; the ring answers with one 0x24 packet. Stop writes 0x23 00. The coordinator runs the window for 45 s. Reply is synthetic. Events carry the session nowMs as t (0x24 has no timestamp).",
      "context": {
        "nowMs": 1700000000000,
        "tzOffsetS": 0
      },
      "steps": [
        {
          "do": "spot:combined"
        },
        {
          "expectWrite": "23 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "24 48 6e 46 61 28 1e 33 00 00 00 00 00 00 00 00 00 00 00 00"
          ],
          "expectEvents": [
