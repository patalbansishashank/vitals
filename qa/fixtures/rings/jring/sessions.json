    {
      "name": "spot heart rate rides the live stream (0x14), then stops",
      "note": "measureHeartRateSpot is startHeartRate; the coordinator samples a 30 s window, ignores the first 5 s (cached echo) and then stops. Origin is spot for the port because the session asked for a spot measurement.",
      "context": {
        "nowMs": 1700000100000,
        "tzOffsetS": 0
      },
      "steps": [
        {
          "do": "spot:hr"
        },
        {
          "expectWrite": "14 b4 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "14 6a f1 53 65 44 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
