      "name": "forget: unbind and wait for the ring acknowledgement",
      "note": "RingBLEClient.forgetAndWait writes 0x4B 05 and waits up to 1.5 s for UNBOND_ACK (action 6) or ACK_CANCEL (action 3) before tearing the link down.",
      "context": {
        "nowMs": 1700000000000,
        "tzOffsetS": 0
      },
      "steps": [
        {
          "do": "forget"
        },
        {
          "expectWrite": "4b 05 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "notify": [
            "4b 06 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
          ]
        }
      ]
    }
  ]
