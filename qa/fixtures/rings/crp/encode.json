    {
      "name": "setTime is group1 cmd1 with 4-byte little-endian epoch and tz byte 8 (phone at UTC+1)",
      "source": "app/src/test/java/com/pulseloop/ring/CRPProtocolTest.kt",
      "command": {
        "op": "set_time",
        "params": {
          "nowMs": 1784709000000,
          "tzOffsetS": 3600
        }
      },
      "frame": "fd da 10 0b 01 01 18 1d 60 6a 08",
      "note": "Kotlin asserts only the header, len 11, group 1, cmd 1, tz byte 8 and a 2020s epoch (it uses LocalDateTime.now()). Bytes here derived from the rule: local wall clock 2026-07-22 09:30:00 encoded as if at UTC+8, so the epoch field is 2026-07-22T01:30:00Z = 1784683800."
    },
    {
      "name": "setTime: phone at UTC-5 across a date line",
      "source": "app/src/test/java/com/pulseloop/ring/CRPProtocolTest.kt",
      "command": {
        "op": "set_time",
        "params": {
          "nowMs": 1767654900000,
          "tzOffsetS": -18000
        }
      },
      "frame": "fd da 10 0b 01 01 24 8f 5b 69 08",
      "note": "Derived from the rule, not asserted in Kotlin: local wall clock 2026-01-05 18:15:00 encoded as if at UTC+8 -> epoch field 2026-01-05T10:15:00Z = 1767608100."
    },
    {
      "name": "setTime: phone at UTC+8 sends the true epoch",
      "source": "app/src/test/java/com/pulseloop/ring/CRPProtocolTest.kt",
      "command": {
        "op": "set_time",
        "params": {
          "nowMs": 1784683800000,
          "tzOffsetS": 28800
        }
      },
      "frame": "fd da 10 0b 01 01 18 1d 60 6a 08",
      "note": "Derived: at UTC+8 the vendor quirk is a no-op, the epoch field equals the real epoch (1784683800)."
    },
