    {
      "name": "frame builds length and CRC matching captured setTime",
      "source": "YCBTProtocolTest.kt",
      "command": {
        "op": "frame",
        "params": {
          "logical": "01 00 ea 07 07 06 0c 22 0e 00"
        }
      },
      "logical": "01 00 ea 07 07 06 0c 22 0e 00",
      "frame": "01 00 0e 00 ea 07 07 06 0c 22 0e 00 26 c7",
      "note": "Kotlin asserts the framed bytes 01000e00ea0707060c220e0026c7. CRC16 over the 12 bytes before the CRC is 0xc726 (asserted in \"CRC16 matches captured setTime body\"), sent little-endian as 26 c7."
    },
    {
      "name": "setTime weekday byte is correct for every day (Mon)",
      "source": "YCBTEncoderTest.kt",
      "command": {
        "op": "setTime",
        "params": {
          "instant": "2026-07-06T12:34:14Z",
          "tz": "UTC"
        }
      },
      "logical": "01 00 ea 07 07 06 0c 22 0e 00",
      "frame": "01 00 0e 00 ea 07 07 06 0c 22 0e 00 26 c7",
      "note": "Kotlin asserts only the last (weekday) byte = 0 (Mon=0 … Sun=6); the rest is derived from YCBTSettingsEncoder.setTime."
    },
