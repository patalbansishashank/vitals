{
  "family": "luckring",
  "source": "LuckRingDecoderTest.kt, LuckRingDriverTest.kt, LuckRingProtocolTest.kt (Kotlin, upstream PulseLoopAndroid; synthetic packets only)",
  "conventions": {
    "packets": "bytes / bytesSequence are on-air 20-byte packets built from the logical frame in context (the Kotlin decoder tests build LuckRingFrame objects, so the packets are derived with the Kotlin packetizer rules).",
    "events": "Fields the Kotlin test asserts, only. Timestamps are epoch seconds (timestampS). A port test should match them as a subset.",
    "derived": "The full decoder output for the vector, computed from the Kotlin source (not asserted by Kotlin).",
    "kotlinClasses": "RingDecodedEvent class names; see the doc section \"Mapping to RingEvent\"."
  },
