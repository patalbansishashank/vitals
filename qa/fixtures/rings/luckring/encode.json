        "op": "userInfo",
        "params": {
          "sex": "male",
          "ageYears": 30,
          "heightCm": 175,
          "weightKg": 70,
          "userId": 0
        }
      },
      "seq": 0,
      "devType": 1,
      "cmdType": "SEND",
      "dataType": 102,
      "payload": "00 00 00 00 00 1e af 46 00",
      "frame": "00 01 00 00 01 66 00 00 09 00 00 00 00 00 00 1e af 46 00 00",
      "packets": [
        "00 01 00 00 01 66 00 00 09 00 00 00 00 00 00 1e af 46 00 00"
      ],
      "note": "Kotlin asserts the 9 payload bytes (userInfoBytes); the frame wrapper (Encoder.userInfo, seq 0) is derived. sex byte inverted: male -> 0."
    },
