    {
      "name": "live heart rate and spot SpO2 (live toggles)",
      "source": "derived from LuckRingSyncEngine.kt / LuckRingDecoder.kt (not a Kotlin test); the replies are synthetic",
      "derived": true,
      "setup": {
        "kind": "syncEngine",
        "clock": {
          "nowMs": 1700000100000,
          "tzOffsetS": 0
        },
        "freshEncoderSeq": 0
      },
      "steps": [
        {
          "do": {
            "startHeartRate": true
          },
          "expectWrite": "00 01 00 00 01 18 00 00 01 00 01 00 00 00 00 00 00 00 00 00",
          "comment": "Real HR toggle (24) on, seq 0. A spot HR reading is the first usable sample of this same stream."
        },
        {
          "notify": [
            "00 01 00 00 02 07 00 00 08 00 01 00 01 05 f1 53 65 42 00 00"
          ],
          "expectNoWrite": true,
