            "runStartup": true
          }
        },
        {
          "expectWrite": "00 01 03 00 01 6e 00 00 43 00 41 00 07 0c 00 66 00 00 00 00",
          "comment": "MixInfo binding bundle (110), head packet; 67-byte TLV payload in 4 packets. seq 0."
        },
        {
          "expectWrite": "01 01 14 00 00 00 0c 00 68 00 f1 53 65 00 00 00 00 00 08 00"
        },
        {
          "expectWrite": "02 7c 01 ff ff 00 00 04 00 67 00 04 00 6d 01 13 00 6f 10 27"
        },
        {
          "expectWrite": "03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 05 00 78 00 00"
        },
        {
          "expectWrite": "00 01 00 01 01 80 00 00 08 00 01 00 1e 01 00 00 00 00 00 00",
          "comment": "Auto monitoring (128): HR on, 30 min, SpO2 on. seq 1."
        },
        {
          "expectWrite": "00 01 00 02 03 02 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "comment": "REQUEST device info (2), seq 2."
        },
        {
          "expectWrite": "00 01 00 03 03 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "comment": "REQUEST battery (3), seq 3."
        },
        {
          "expectWrite": "00 01 00 04 03 09 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "comment": "REQUEST settings sync (9), seq 4."
        },
        {
          "expectWrite": "00 01 00 00 03 05 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "expectProgress": [
            "Syncing activity..."
          ],
          "comment": "History pager starts: REQUEST activity history (5); the pager has its own seq counter, starting at 0."
        },
        {
          "do": {
            "runStartup": true
          },
          "expectNoWrite": true,
          "comment": "A pass already in flight wins: the second runStartup writes nothing."
