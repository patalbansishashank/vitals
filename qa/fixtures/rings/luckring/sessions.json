        },
        {
          "do": {
            "runStartup": true
          },
          "expectWrite": "00 01 00 05 03 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "comment": "Warm pass: configurationSent is true, so no bundle, no auto-monitoring, no device info. Encoder seq continues at 5."
        },
        {
          "expectWrite": "00 01 00 06 03 09 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        },
        {
          "expectWrite": "00 01 00 01 03 05 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "expectProgress": [
            "Syncing activity..."
          ],
          "comment": "The pager restarts the catalog; its own seq is now 1."
        },
        {
          "do": {
            "engineReset": true
          },
          "comment": "reset() cancels the pager and clears configurationSent: the next runStartup is cold again (9 packets)."
        }
      ]
    },
    {
