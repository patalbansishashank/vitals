{
  "family": "rwfit",
  "source": "RWfitCodecTest.kt, RWfitDecoderTest.kt, RWfitJLHistoryTest.kt, RWfitDriverTest.kt",
  "timeConvention": "All timestamps are epoch seconds decoded with the zone set to UTC (tzCorrectionS 0). See README.",
  "vectors": [
    {
      "name": "legacy decode yields ack-before-frame in the vendor's order",
      "source": "RWfitCodecTest.kt",
      "framing": "legacy",
      "context": {
        "layer": "codec"
      },
      "bytes": "7e 01 01 00 03 12 34 54 00 01 55",
      "events": [
        {
          "kotlin": "RWfitLegacyInbound.AckNeeded",
          "cmd": "0x01",
          "serial": 4660
        },
        {
          "kotlin": "RWfitLegacyInbound.Frame",
          "cmd": "0x01",
          "payload": "00 01 55"
        }
      ]
    },
    {
      "name": "legacy decode reports a checksum failure instead of the frame",
      "source": "RWfitCodecTest.kt",
      "framing": "legacy",
      "context": {
        "layer": "codec"
      },
      "bytes": "7e 01 01 00 02 00 09 7f 11 22",
      "events": [
        {
          "kotlin": "RWfitLegacyInbound.ChecksumFailed",
          "cmd": "0x01",
          "serial": 9
        }
      ],
      "note": "Negative: XOR of 11 22 is 0x33, header says 0x7f."
    },
    {
      "name": "legacy device ack is parsed and never itself acked",
      "source": "RWfitCodecTest.kt",
      "framing": "legacy",
      "context": {
        "layer": "codec"
      },
      "bytes": "7e 01 fe 00 04 00 05 0b 00 2a 21 00",
      "events": [
        {
          "kotlin": "RWfitLegacyInbound.DeviceAck",
          "cmd": "0x21",
          "serial": 42,
          "status": "0x00"
        }
      ]
    },
    {
      "name": "legacy multi-packet frames reassemble in index order",
      "source": "RWfitCodecTest.kt",
      "framing": "legacy",
      "context": {
        "layer": "codec"
      },
      "bytesSequence": [
        "7e 01 a3 08 02 00 01 33 00 02 00 01 11 22",
        "7e 01 a3 08 01 00 02 33 00 02 00 02 33"
      ],
      "eventsPerPacket": [
        [
          {
            "kotlin": "RWfitLegacyInbound.AckNeeded",
            "cmd": "0xa3",
            "serial": 1
          }
        ],
        [
          {
            "kotlin": "RWfitLegacyInbound.AckNeeded",
            "cmd": "0xa3",
            "serial": 2
          },
          {
            "kotlin": "RWfitLegacyInbound.Frame",
            "cmd": "0xa3",
            "payload": "11 22 33"
          }
        ]
      ],
      "events": [
        {
          "kotlin": "RWfitLegacyInbound.AckNeeded",
          "cmd": "0xa3",
          "serial": 1
        },
        {
          "kotlin": "RWfitLegacyInbound.AckNeeded",
          "cmd": "0xa3",
          "serial": 2
        },
        {
          "kotlin": "RWfitLegacyInbound.Frame",
          "cmd": "0xa3",
          "payload": "11 22 33"
        }
      ],
      "note": "Header serial = chunk index in this test. Packet 2: the test asserts size 2 and events[1]; events[0] (AckNeeded serial 2) follows from the codec source."
    },
    {
      "name": "legacy reset drops a half-assembled frame",
      "source": "RWfitCodecTest.kt",
      "framing": "legacy",
      "context": {
        "layer": "codec",
        "resetBeforePacket": [
          1
        ]
      },
      "bytesSequence": [
        "7e 01 a3 08 01 00 01 11 00 02 00 01 11",
        "7e 01 a3 08 01 00 02 22 00 02 00 02 22"
      ],
      "eventsPerPacket": [
        [
          {
            "kotlin": "RWfitLegacyInbound.AckNeeded",
            "cmd": "0xa3",
            "serial": 1
          }
        ],
        [
          {
            "kotlin": "RWfitLegacyInbound.AckNeeded",
            "cmd": "0xa3",
            "serial": 2
          }
        ]
      ],
      "events": [
        {
          "kotlin": "RWfitLegacyInbound.AckNeeded",
          "cmd": "0xa3",
          "serial": 1
        },
        {
          "kotlin": "RWfitLegacyInbound.AckNeeded",
          "cmd": "0xa3",
          "serial": 2
        }
      ],
      "note": "Codec reset (connect/disconnect) between the packets; the stale chunk must not complete the frame. Asserted: packet 2 yields exactly one AckNeeded."
    },
