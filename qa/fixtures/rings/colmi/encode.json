      "command": {
        "op": "autoHeartRate",
        "params": {
          "enabled": false,
          "intervalMinutes": 5
        }
      },
      "kotlin": "ColmiEncoder.autoHeartRate(enabled = false, intervalMinutes = 5)",
      "content": "16 02 02 05 00 00 00 00",
      "frame": "16 02 02 05 00 00 00 00 00 00 00 00 00 00 00 1f",
      "channel": "write",
      "asserted": "full content"
    },
