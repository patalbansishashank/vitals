    {
      "name": "heart rate request sends the calendar date at midnight UTC (local date equals UTC date)",
      "test": "ColmiQringParityTest.kt",
      "command": {
        "op": "syncHeartRate",
        "params": {
          "daysAgo": 0,
          "nowMs": 1784282400000,
          "tzOffsetS": 7200
        }
      },
      "kotlin": "ColmiEncoder.syncHeartRate(2026-07-17 at 00:00 UTC = 1784246400)",
      "content": "15 80 70 59 6a",
      "frame": "15 80 70 59 6a 00 00 00 00 00 00 00 00 00 00 c8",
      "channel": "write",
      "asserted": "u32 LE at content[1..4] == LocalDate.now(systemDefault).atStartOfDay(UTC).epochSecond",
      "localDay": "2026-07-17",
      "note": "The test uses the machine clock; the instant and offset here are synthetic. The value is the person's LOCAL calendar date at 00:00 UTC, not local midnight."
    },
