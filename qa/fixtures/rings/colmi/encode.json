{
  "family": "colmi",
  "source": "Kotlin unit tests of the upstream Android app (app/src/test/java/com/pulseloop/ring/Colmi*Test.kt); see each vector's \"test\"",
  "conventions": {
    "content": "What ColmiEncoder returns (the Kotlin tests assert this): opcode + sub-data, unframed for normal commands.",
    "frame": "The bytes on the air. Normal commands: content zero-padded to 15 bytes + checksum (sum of bytes 0..14 & 0xff) = 16 bytes, written to 6e400002-…. Big-data requests (first byte 0xbc): written raw to de5bf72a-… (\"command\").",
    "asserted": "Which bytes the Kotlin test actually checks; the rest of the frame is computed from ColmiEncoder.kt.",
    "time": "Time-dependent vectors carry nowMs (UTC epoch ms) and tzOffsetS (local offset east of UTC, seconds). The Kotlin tests use the machine clock; these instants are synthetic."
  },
  "vectors": [
    {
      "name": "frame appends checksum and is 16 bytes",
      "test": "ColmiDecoderTest.kt",
      "command": {
        "op": "battery",
        "params": {}
      },
      "kotlin": "ColmiPacket.frame(byteArrayOf(0x03))",
      "content": "03",
      "frame": "03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03",
      "channel": "write",
      "asserted": "framed size 16 and frame[15] == 0x03"
    },
    {
      "name": "encoder phone name",
      "test": "ColmiDecoderTest.kt",
      "command": {
        "op": "phoneName",
        "params": {}
      },
      "kotlin": "ColmiEncoder.phoneName()",
      "content": "04 02 0a 50 4c",
      "frame": "04 02 0a 50 4c 00 00 00 00 00 00 00 00 00 00 ac",
      "channel": "write",
      "asserted": "content[0] == 0x04, content[3] == 'P', content[4] == 'L'",
      "note": "Bytes 1..2 (02 0a) are a constant the Kotlin never explains; the name sent is always \"PL\"."
    },
    {
      "name": "auto heart rate enable carries 0x01 flag, interval and zeroed alarm fields",
      "test": "ColmiDecoderTest.kt",
      "command": {
        "op": "autoHeartRate",
        "params": {
          "enabled": true,
          "intervalMinutes": 5
        }
      },
      "kotlin": "ColmiEncoder.autoHeartRate(enabled = true, intervalMinutes = 5)",
      "content": "16 02 01 05 00 00 00 00",
      "frame": "16 02 01 05 00 00 00 00 00 00 00 00 00 00 00 1e",
      "channel": "write",
      "asserted": "full content"
    },
    {
      "name": "auto heart rate disable uses 0x02 flag",
