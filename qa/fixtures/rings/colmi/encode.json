    {
      "name": "colmi routes big data to command channel",
      "test": "ColmiDecoderTest.kt",
      "command": {
        "op": "bigDataSleep",
        "params": {}
      },
      "kotlin": "ColmiDriver.usesCommandChannel(bc 27 …)",
      "content": "bc 27 02 00 81 80 ff 01",
      "frame": "bc 27 02 00 81 80 ff 01",
      "channel": "command",
      "asserted": "a frame starting 0xBC goes to the command characteristic (de5bf72a-…); a framed 0x03 does not",
      "note": "Same bytes as the bigDataSleep vector; kept to record the routing rule."
    },
