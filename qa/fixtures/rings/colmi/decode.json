{
  "family": "colmi",
  "source": "Kotlin unit tests of the upstream Android app (app/src/test/java/com/pulseloop/ring/Colmi*Test.kt); see each vector's \"test\"",
  "conventions": {
    "events": "Exactly what the Kotlin test asserts: \"kotlin\" is the RingDecodedEvent (or helper) class, other keys are the asserted fields. [] = the test asserts nothing comes out.",
    "derivedEvents": "Full output computed by reading ColmiDecoder.kt / ColmiDriver.kt (not asserted by a test). Timestamps are ISO UTC. SleepTimeline stages are run-length encoded here (Kotlin expands one entry per minute).",
    "context": "nowMs = synthetic instant for live frames (their timestamp is \"now\"); day / todayLocal = the local calendar day the decoder anchors to; tzOffsetS = local offset east of UTC (the tests run in UTC).",
    "channel": "\"notify\" = 6e400003-… (16-byte frames), \"bigData\" = de5bf729-… (raw 0xbc frames, any chunking).",
    "bigDataReplyCrc": "Big-data replies in the tests carry 00 00 in the CRC slot (bytes 4..5); the Kotlin never checks it.",
    "excluded": "ColmiDecoderTest \"real activity buckets decode without calories\" uses seven captured on-ring frames; left out because these fixtures are synthetic only."
  },
  "vectors": [
    {
      "name": "every sport telemetry frame is tagged for masking (warm-up, bpm 0)",
      "test": "ColmiDecoderTest.kt",
      "decoder": "ColmiDecoder.decodeNormal",
      "channel": "notify",
      "context": {
        "nowMs": 1784282400000
      },
      "bytes": "78 01 00 00 00 00 00 07 d0 00 00 00 00 00 00 50",
      "events": [
        {
          "kotlin": "SportTelemetry",
          "kind": "sport_telemetry"
        }
      ],
      "derivedEvents": [
        {
          "kotlin": "SportTelemetry",
          "kind": "sport_telemetry",
          "bpm": 0,
          "_timestamp": "2026-07-17T10:00:00Z"
        }
      ],
      "assertedCount": 1
    },
